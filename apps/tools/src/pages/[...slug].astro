---
import { getCollection, render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import EmbeddedTool from "@components/EmbeddedTool.tsx";
import { TOOL_COMPONENTS } from "@tools/index";
import { getToolTypeMeta, STATUS_META } from "@lib/utils";

export async function getStaticPaths() {
  const tools = await getCollection("tools");
  return tools
    .filter((t) => t.data.hostType === "internal")
    .map((t) => ({ params: { slug: t.id }, props: { entry: t } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const typeMeta = getToolTypeMeta(d.toolType);
const statusMeta = STATUS_META[d.status] ?? STATUS_META["active"];
const canonical = `https://tools.ogutdgn.com/${entry.id}`;
---
<BaseLayout title={`${d.title} | tools.ogutdgn.com`} description={d.tagline ?? d.overview} canonical={canonical}>

  <div class="max-w-4xl mx-auto px-6 pt-24 pb-16">

    <a
      href="/"
      class="inline-flex items-center gap-2 font-mono text-xs text-muted hover:text-text transition-colors mb-10 group"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
        <path d="m15 18-6-6 6-6"/>
      </svg>
      back to tools
    </a>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-10">

      {/* left */}
      <div>
        {/* header */}
        <div class="flex items-start gap-4 mb-6">
          {d.icon ? (
            <div class="w-14 h-14 rounded-xl border border-border overflow-hidden flex-shrink-0">
              <img
                src={d.icon}
                alt={d.title}
                width="56"
                height="56"
                class="w-full h-full object-cover"
              />
            </div>
          ) : (
            <div class={`w-14 h-14 rounded-xl border flex items-center justify-center flex-shrink-0 ${typeMeta.bg}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class={typeMeta.color}>
                <circle cx="12" cy="12" r="10"/>
                <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
            </div>
          )}

          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2 mb-2">
              <span class={`inline-flex items-center px-2.5 py-1 rounded-md border font-mono text-xs ${typeMeta.bg} ${typeMeta.color}`}>{typeMeta.label}</span>
              <span class="flex items-center gap-1.5">
                {(d.status === "active" || d.status === "beta") && (
                  <span class="relative flex h-2 w-2">
                    <span class={`animate-ping absolute inline-flex h-full w-full rounded-full ${statusMeta.dot} opacity-60`}></span>
                    <span class={`relative inline-flex rounded-full h-2 w-2 ${statusMeta.dot}`}></span>
                  </span>
                )}
                <span class={`font-mono text-xs ${statusMeta.color}`}>{statusMeta.label}</span>
              </span>
            </div>
            <h1 class="text-2xl font-bold text-text">{d.title}</h1>
            {d.tagline && <p class="text-muted text-sm mt-1">{d.tagline}</p>}
          </div>
        </div>

        {d.overview && (
          <p class="text-muted leading-relaxed mb-8 text-sm border-l-2 border-neon/40 pl-4">
            {d.overview}
          </p>
        )}

        {d.coverImage && (
          <div class="rounded-xl overflow-hidden border border-border mb-8">
            <img
              src={d.coverImage}
              alt={d.title}
              width="1200"
              height="600"
              class="w-full object-cover"
            />
          </div>
        )}

        <article class="tool-prose mb-8">
          <Content />
        </article>

        {d.screenshots && d.screenshots.length > 0 && (
          <div class="mb-8">
            <h2 class="font-mono text-xs text-dim uppercase tracking-widest mb-4">Screenshots</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {d.screenshots.map((s, i) => (
                <div class="rounded-lg overflow-hidden border border-border">
                  <img
                    src={s.src}
                    alt={s.caption ?? `Screenshot ${i + 1}`}
                    width="800"
                    height="450"
                    class="w-full object-cover"
                  />
                  {s.caption && (
                    <p class="text-xs text-dim font-mono px-3 py-2 bg-surface">{s.caption}</p>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {d.demoVideoUrl && (
          <div class="mb-8">
            <h2 class="font-mono text-xs text-dim uppercase tracking-widest mb-4">Demo</h2>
            <div class="aspect-video rounded-xl overflow-hidden border border-border">
              <iframe src={d.demoVideoUrl} class="w-full h-full" allowfullscreen></iframe>
            </div>
          </div>
        )}

        {TOOL_COMPONENTS[entry.id] && (
          <div class="mb-8">
            <h2 class="font-mono text-xs text-dim uppercase tracking-widest mb-4">Try it</h2>
            <EmbeddedTool slug={entry.id} client:only="react" />
          </div>
        )}
      </div>

      {/* right sidebar */}
      <div class="space-y-4">

        {/* links */}
        <div class="space-y-2">
          {d.liveLink && d.hostType !== "internal" && (
            <a
              href={d.liveLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 px-4 py-3 rounded-lg border border-neon/40 bg-neon/10 hover:bg-neon/20 transition-all group"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-neon">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                <polyline points="15 3 21 3 21 9"/>
                <line x1="10" y1="14" x2="21" y2="3"/>
              </svg>
              <span class="font-mono text-sm text-neon">Open Tool</span>
            </a>
          )}
          {d.githubLink && (
            <a
              href={d.githubLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 px-4 py-3 rounded-lg border border-border bg-surface hover:border-border-bright transition-all group"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-muted group-hover:text-text transition-colors">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
              <span class="font-mono text-sm text-muted group-hover:text-text transition-colors">GitHub</span>
            </a>
          )}
        </div>

        {d.technologies && d.technologies.length > 0 && (
          <div class="p-4 bg-surface border border-border rounded-xl">
            <p class="font-mono text-xs text-dim mb-3 flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
                <rect x="9" y="9" width="6" height="6"/>
                <line x1="9" y1="2" x2="9" y2="4"/>
                <line x1="15" y1="2" x2="15" y2="4"/>
                <line x1="9" y1="20" x2="9" y2="22"/>
                <line x1="15" y1="20" x2="15" y2="22"/>
                <line x1="20" y1="9" x2="22" y2="9"/>
                <line x1="20" y1="14" x2="22" y2="14"/>
                <line x1="2" y1="9" x2="4" y2="9"/>
                <line x1="2" y1="14" x2="4" y2="14"/>
              </svg>
              built with
            </p>
            <div class="flex flex-wrap gap-1.5">
              {d.technologies.map((t) => (
                <span class="font-mono text-xs text-muted bg-surface-2 border border-border px-2 py-1 rounded">
                  {t}
                </span>
              ))}
            </div>
          </div>
        )}

        {d.tags && d.tags.length > 0 && (
          <div class="p-4 bg-surface border border-border rounded-xl">
            <p class="font-mono text-xs text-dim mb-3 flex items-center gap-1.5">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
              </svg>
              tags
            </p>
            <div class="flex flex-wrap gap-1.5">
              {d.tags.map((t) => (
                <span class="font-mono text-xs text-dim px-2 py-1 rounded border border-border">
                  #{t}
                </span>
              ))}
            </div>
          </div>
        )}

        {d.publishedAt && (
          <p class="font-mono text-xs text-dim px-1">
            published <span class="text-muted">{d.publishedAt.toISOString().slice(0, 10)}</span>
          </p>
        )}
      </div>
    </div>
  </div>

</BaseLayout>
