---
interface Props {
  spriteImage?: string;
}

const { spriteImage = "/mini-dogan.png" } = Astro.props;
---

<script is:inline define:vars={{ spriteImage }}>
  const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!isReducedMotion) {
    const nekoEl = document.createElement("div");
    let nekoPosX = 32;
    let nekoPosY = 32;
    let mousePosX = 0;
    let mousePosY = 0;
    let frameCount = 0;
    let idleTime = 0;
    let idleAnimation = null;
    let idleAnimationFrame = 0;
    let lastFrameTimestamp;
    let shadowEl;

    const nekoSpeed = 10;
    const cellSize = 64; // sprite cell size in px (matches generate-sprite.mjs)
    const half = cellSize / 2;
    const jumpHeight = 34;   // peak rise of a jump in px
    const JUMP_CROUCH = 2;   // anticipation frames before takeoff
    const JUMP_AIR = 11;     // frames spent airborne
    const JUMP_LAND = 3;     // landing squash frames
    const spriteSets = {
      idle: [[-3, -3]],
      alert: [[-7, -3]],
      scratchSelf: [[-5, 0], [-6, 0], [-7, 0]],
      scratchWallN: [[0, 0], [0, -1]],
      scratchWallS: [[-7, -1], [-6, -2]],
      scratchWallE: [[-2, -2], [-2, -3]],
      scratchWallW: [[-4, 0], [-4, -1]],
      jumpCrouch: [[-2, 0]],
      jumpAir: [[-2, -1]],
      N: [[-1, -2], [-1, -3]],
      NE: [[0, -2], [0, -3]],
      E: [[-3, 0], [-3, -1]],
      SE: [[-5, -1], [-5, -2]],
      S: [[-6, -3], [-7, -2]],
      SW: [[-5, -3], [-6, -1]],
      W: [[-4, -2], [-4, -3]],
      NW: [[-1, 0], [-1, -1]],
    };

    function init() {
      nekoEl.id = "mini-dogan";
      nekoEl.ariaHidden = true;
      nekoEl.style.width = `${cellSize}px`;
      nekoEl.style.height = `${cellSize}px`;
      nekoEl.style.position = "fixed";
      nekoEl.style.pointerEvents = "auto";
      nekoEl.style.imageRendering = "pixelated";
      nekoEl.style.left = `${nekoPosX - half}px`;
      nekoEl.style.top = `${nekoPosY - half}px`;
      nekoEl.style.zIndex = 40; // above page content, below the z-50 sticky navbar
      nekoEl.style.backgroundImage = `url(${spriteImage})`;

      shadowEl = document.createElement("div");
      shadowEl.id = "mini-dogan-shadow";
      shadowEl.setAttribute("aria-hidden", "true");
      shadowEl.style.position = "fixed";
      shadowEl.style.height = "7px";
      shadowEl.style.borderRadius = "50%";
      shadowEl.style.background = "rgba(0, 0, 0, 0.3)";
      shadowEl.style.filter = "blur(2px)";
      shadowEl.style.pointerEvents = "none";
      shadowEl.style.zIndex = 39; // just under the mascot
      shadowEl.style.display = "none";

      document.body.appendChild(nekoEl);
      document.body.appendChild(shadowEl);
      nekoEl.addEventListener("click", explodeHearts);

      // Track the cursor. ClientRouter re-runs this inline script on every
      // navigation, so remove any previous document-level listener first to
      // avoid leaking a handler per page view.
      if (window.__miniDoganMouseMove) {
        document.removeEventListener("mousemove", window.__miniDoganMouseMove);
      }
      window.__miniDoganMouseMove = (event) => {
        mousePosX = event.clientX;
        mousePosY = event.clientY;
      };
      document.addEventListener("mousemove", window.__miniDoganMouseMove);

      window.requestAnimationFrame(onAnimationFrame);
    }

    function onAnimationFrame(timestamp) {
      if (!nekoEl.isConnected) return;
      
      if (!lastFrameTimestamp) {
        lastFrameTimestamp = timestamp;
      }
      if (timestamp - lastFrameTimestamp > 100) {
        lastFrameTimestamp = timestamp;
        frame();
      }
      window.requestAnimationFrame(onAnimationFrame);
    }

    function setSprite(name, frame) {
      const sprite = spriteSets[name][frame % spriteSets[name].length];
      nekoEl.style.backgroundPosition = `${sprite[0] * cellSize}px ${sprite[1] * cellSize}px`;
    }

    function resetIdleAnimation() {
      idleAnimation = null;
      idleAnimationFrame = 0;
    }

    function idle() {
      idleTime += 1;

      // After a short pause, occasionally do a little idle animation. The mascot
      // jumps (no sleeping), or waves/stretches toward a nearby wall.
      if (idleTime > 6 && Math.floor(Math.random() * 40) == 0 && idleAnimation == null) {
        let availableIdleAnimations = ["jump", "jump", "jump", "scratchSelf"];
        if (nekoPosX < cellSize) availableIdleAnimations.push("scratchWallW");
        if (nekoPosY < cellSize) availableIdleAnimations.push("scratchWallN");
        if (nekoPosX > window.innerWidth - cellSize) availableIdleAnimations.push("scratchWallE");
        if (nekoPosY > window.innerHeight - cellSize) availableIdleAnimations.push("scratchWallS");

        idleAnimation = availableIdleAnimations[Math.floor(Math.random() * availableIdleAnimations.length)];
      }

      switch (idleAnimation) {
        case "jump": {
          // A real jump: crouch (anticipation) -> airborne tuck -> landing squash,
          // with the body changing pose, a shrinking ground shadow and dust puffs.
          const f = idleAnimationFrame;
          const groundTop = nekoPosY - half;
          const footY = nekoPosY + half - 6;

          if (f < JUMP_CROUCH) {
            // Crouch down before launching.
            setSprite("jumpCrouch", 0);
            nekoEl.style.top = `${groundTop}px`;
            updateShadow(0, footY);
          } else if (f < JUMP_CROUCH + JUMP_AIR) {
            // Airborne: parabolic rise/fall with legs tucked.
            const a = f - JUMP_CROUCH;
            if (a === 0) spawnDust(nekoPosX, footY); // kick off on takeoff
            const offset = Math.round(Math.sin((a / (JUMP_AIR - 1)) * Math.PI) * jumpHeight);
            setSprite("jumpAir", 0);
            nekoEl.style.top = `${groundTop - offset}px`;
            updateShadow(offset, footY);
          } else if (f < JUMP_CROUCH + JUMP_AIR + JUMP_LAND) {
            // Land with a squash.
            if (f === JUMP_CROUCH + JUMP_AIR) spawnDust(nekoPosX, footY);
            setSprite("jumpCrouch", 0);
            nekoEl.style.top = `${groundTop}px`;
            updateShadow(0, footY);
          } else {
            nekoEl.style.top = `${groundTop}px`;
            hideShadow();
            resetIdleAnimation();
          }
          break;
        }
        case "scratchWallN":
        case "scratchWallS":
        case "scratchWallE":
        case "scratchWallW":
        case "scratchSelf":
          setSprite(idleAnimation, idleAnimationFrame);
          if (idleAnimationFrame > 9) resetIdleAnimation();
          break;
        default:
          setSprite("idle", 0);
          return;
      }
      idleAnimationFrame += 1;
    }

    function explodeHearts() {
      const parent = nekoEl.parentElement;
      const rect = nekoEl.getBoundingClientRect();
      const scrollLeft = window.scrollX || document.documentElement.scrollLeft;
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const centerX = rect.left + rect.width / 2 + scrollLeft;
      const centerY = rect.top + rect.height / 2 + scrollTop;

      for (let i = 0; i < 10; i++) {
        const heart = document.createElement('div');
        heart.className = 'heart';
        heart.textContent = '❤';
        const offsetX = (Math.random() - 0.5) * 50;
        const offsetY = (Math.random() - 0.5) * 50;
        heart.style.left = `${centerX + offsetX - 16}px`;
        heart.style.top = `${centerY + offsetY - 16}px`;
        heart.style.transform = `translate(-50%, -50%) rotate(${Math.random() * 360}deg)`;
        parent.appendChild(heart);

        setTimeout(() => parent.removeChild(heart), 1000);
      }
    }

    // Ground shadow that shrinks/fades as the mascot rises during a jump.
    function updateShadow(offset, footY) {
      const k = Math.max(0, Math.min(1, offset / jumpHeight)); // 0 = grounded, 1 = peak
      const w = cellSize * (0.42 - 0.22 * k);
      shadowEl.style.display = "block";
      shadowEl.style.width = `${w}px`;
      shadowEl.style.left = `${nekoPosX - w / 2}px`;
      shadowEl.style.top = `${footY}px`;
      shadowEl.style.opacity = `${0.3 * (1 - 0.65 * k)}`;
    }

    function hideShadow() {
      if (shadowEl) shadowEl.style.display = "none";
    }

    // Little dust puffs kicked up on takeoff and landing.
    function spawnDust(centerX, footY) {
      for (let i = 0; i < 6; i++) {
        const dust = document.createElement("div");
        dust.className = "mini-dogan-dust";
        const dx = (Math.random() - 0.5) * 2 * 20;
        const dy = -Math.random() * 10;
        dust.style.left = `${centerX}px`;
        dust.style.top = `${footY}px`;
        dust.style.setProperty("--dx", `${dx}px`);
        dust.style.setProperty("--dy", `${dy}px`);
        dust.style.zIndex = 41;
        document.body.appendChild(dust);
        setTimeout(() => dust.remove(), 550);
      }
    }

    function frame() {
      frameCount += 1;
      const diffX = nekoPosX - mousePosX;
      const diffY = nekoPosY - mousePosY;
      const distance = Math.sqrt(diffX ** 2 + diffY ** 2);

      if (distance < nekoSpeed || distance < 48) {
        idle();
        return;
      }

      idleAnimation = null;
      idleAnimationFrame = 0;
      hideShadow(); // in case a jump was interrupted mid-air

      if (idleTime > 1) {
        setSprite("alert", 0);
        idleTime = Math.min(idleTime, 7);
        idleTime -= 1;
        return;
      }

      let direction = "";
      direction += diffY / distance > 0.5 ? "N" : "";
      direction += diffY / distance < -0.5 ? "S" : "";
      direction += diffX / distance > 0.5 ? "W" : "";
      direction += diffX / distance < -0.5 ? "E" : "";
      setSprite(direction, frameCount);

      nekoPosX -= (diffX / distance) * nekoSpeed;
      nekoPosY -= (diffY / distance) * nekoSpeed;

      nekoPosX = Math.min(Math.max(half, nekoPosX), window.innerWidth - half);
      nekoPosY = Math.min(Math.max(half, nekoPosY), window.innerHeight - half);

      nekoEl.style.left = `${nekoPosX - half}px`;
      nekoEl.style.top = `${nekoPosY - half}px`;
    }

    init();
  }
</script>

<style>
  @keyframes heartBurst {
    0% { transform: scale(0); opacity: 1; }
    100% { transform: scale(1); opacity: 0; }
  }
  
  :global(.heart) {
    position: absolute;
    font-size: 2em;
    animation: heartBurst 1s ease-out;
    animation-fill-mode: forwards;
    color: #ab9df2;
  }

  @keyframes dustPuff {
    0% { transform: translate(-50%, -50%) scale(0.4); opacity: 0.7; }
    100% {
      transform: translate(calc(-50% + var(--dx, 0px)), calc(-50% + var(--dy, 0px))) scale(1.4);
      opacity: 0;
    }
  }

  :global(.mini-dogan-dust) {
    position: fixed;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(150, 150, 150, 0.7);
    pointer-events: none;
    animation: dustPuff 0.5s ease-out forwards;
  }
</style>